# ===========================================
# TopVolk Construction — Environment Variables
# Copy to .env.local and fill in values
# ===========================================

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_RECIPIENT_1=volkovvladislav538@gmail.com
EMAIL_RECIPIENT_2=                              # Optional second recipient
EMAIL_FROM=noreply@topvolk.org                  # Requires verified domain in Resend

# --- Telegram Notifications ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=-100xxxxxxxxxx                 # Group chat ID (starts with -100)

# --- Google Tag Manager ---
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX                  # Container ID from GTM

